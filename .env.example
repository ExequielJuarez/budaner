# Copiá este archivo como .env y completá los valores.

# ── Servidor ────────────────────────────────────────────────
# Puerto (Render y otros hostings lo definen solos)
PORT=3000
# HOST=127.0.0.1 deja la web solo para esta compu (sacalo para abrirla desde el celular)
# HOST=0.0.0.0

# En el servidor publicado poné NODE_ENV=production
NODE_ENV=

# ── Sesión del panel ────────────────────────────────────────
# Clave para firmar la cookie de sesión. En producción: una frase larga y secreta.
SESSION_SECRET=

# ── Base de datos MySQL ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=budaner_automotores
# true para ver en consola las consultas SQL
DB_LOG=false
DB_TIMEZONE=-03:00
DB_POOL_MAX=5

# ── Primer administrador (lo crea "npm run db:instalar") ────
# Con estos datos se entra a /admin. Después la clave se cambia desde el panel (Ajustes).
ADMIN_NOMBRE=Administrador
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
