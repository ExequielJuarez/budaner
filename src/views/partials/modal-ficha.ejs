<%# ═════════ Modal "Ficha de la unidad" (lo completa inicio.js con los datos del vehículo) ═════════ %>
<div class="modal" id="modalFicha" role="dialog" aria-modal="true" aria-labelledby="fichaTitulo" hidden>
  <div class="modal__caja modal__caja--ficha">
    <div class="ficha__foto">
      <img id="fichaImagen" src="/img/sin-foto.svg" alt="">
      <button type="button" class="icono-btn icono-btn--flotante" data-cerrar aria-label="Cerrar"><%- icono('x') %></button>
      <span class="chip chip--celeste ficha__etiqueta" id="fichaEtiqueta"></span>
      <button type="button" class="ficha__flecha ficha__flecha--ant" data-foto="-1" aria-label="Foto anterior" hidden><%- icono('chevron-left') %></button>
      <button type="button" class="ficha__flecha ficha__flecha--sig" data-foto="1" aria-label="Foto siguiente" hidden><%- icono('chevron-right') %></button>
    </div>
    <div class="ficha__miniaturas" id="fichaMiniaturas" hidden></div>

    <div class="ficha__cuerpo">
      <div class="ficha__cabecera">
        <div>
          <h3 id="fichaTitulo"></h3>
          <p id="fichaSub"></p>
        </div>
        <p class="ficha__precio" id="fichaPrecio"></p>
      </div>

      <dl class="ficha__datos">
        <div><dt>Kilometraje</dt><dd id="fichaKm"></dd></div>
        <div><dt>Transmisión</dt><dd id="fichaTransmision"></dd></div>
        <div><dt>Combustible</dt><dd id="fichaCombustible"></dd></div>
      </dl>

      <p class="ficha__descripcion" id="fichaDescripcion"></p>

      <div class="ficha__botones">
        <button type="button" class="btn btn--celeste btn--grande" id="fichaAsesor"><%- icono('message-circle') %><span>Consultar con asesor</span></button>
        <button type="button" class="btn btn--gris" data-cerrar>Cerrar</button>
      </div>
    </div>
  </div>
</div>
